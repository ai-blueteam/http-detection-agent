{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schema/http-detection-catalog.schema.json",
  "title": "Normalized HTTP detection catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "dataset", "timestamp_field", "regex_dialect", "sources", "rules"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "dataset": { "enum": ["normalized.http", "cloudflare.http_requests"] },
    "timestamp_field": { "const": "edgeendtimestamp" },
    "regex_dialect": { "const": "rust-regex" },
    "description": { "type": "string" },
    "normalization_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field_names", "missing_values", "url_decode", "header_names"],
      "properties": {
        "field_names": { "const": "lowercase" },
        "missing_values": { "const": "null" },
        "url_decode": { "const": "percent-decode without converting plus to space" },
        "header_names": { "const": "case-insensitive" }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/source" }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/rule" }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "url", "revision", "license"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "name": { "type": "string" },
        "url": { "type": "string", "format": "uri" },
        "revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "license": { "enum": ["Apache-2.0", "DRL-1.1", "Elastic-2.0", "CC-BY-SA-4.0"] },
        "scope_note": { "type": "string" }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "upstream_ids", "path", "authors", "relationship"],
      "properties": {
        "source": { "type": "string" },
        "upstream_ids": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "path": { "type": "string" },
        "authors": { "type": "array", "items": { "type": "string" } },
        "relationship": { "enum": ["derived", "adapted", "corroborates"] }
      }
    },
    "predicate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op"],
      "properties": {
        "field": { "type": "string" },
        "metric": { "type": "string" },
        "op": {
          "enum": [
            "eq", "neq", "in", "not_in", "contains", "contains_any", "starts_with",
            "ends_with", "regex", "exists", "is_null", "lt", "lte", "gt", "gte",
            "map_key_exists", "map_value_regex", "map_key_value_regex", "array_contains_any",
            "array_value_regex", "array_duplicate_header_name"
          ]
        },
        "value": {},
        "values": { "type": "array" },
        "key": { "type": "string" },
        "flags": { "type": "array", "items": { "enum": ["i", "m", "s"] }, "uniqueItems": true },
        "transforms": {
          "type": "array",
          "items": { "enum": ["lowercase", "url_decode_1", "url_decode_2", "html_entity_decode", "path_only"] },
          "uniqueItems": true
        }
      },
      "oneOf": [
        { "required": ["field"] },
        { "required": ["metric"] }
      ]
    },
    "condition": {
      "oneOf": [
        { "$ref": "#/$defs/predicate" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["all"],
          "properties": { "all": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/condition" } } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["any"],
          "properties": { "any": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/condition" } } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["not"],
          "properties": { "not": { "$ref": "#/$defs/condition" } }
        }
      ]
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "op"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "op": { "enum": ["count", "distinct_count", "min", "max", "sum"] },
        "field": { "type": "string" },
        "where": { "$ref": "#/$defs/condition" }
      }
    },
    "aggregate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["group_by", "window_seconds", "metrics", "having"],
      "properties": {
        "group_by": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true },
        "window_seconds": { "type": "integer", "minimum": 1 },
        "prefilter": { "$ref": "#/$defs/condition" },
        "metrics": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/metric" } },
        "having": { "$ref": "#/$defs/condition" }
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "family", "variant", "title", "description", "kind", "status", "severity", "confidence",
        "category", "attack", "required_fields", "requirements", "provenance"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^http\\.[a-z0-9][a-z0-9._-]+$" },
        "family": { "type": "string", "pattern": "^http\\.[a-z0-9][a-z0-9._-]+$" },
        "variant": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "kind": { "enum": ["event", "aggregate"] },
        "status": { "enum": ["production", "test", "experimental"] },
        "severity": { "enum": ["informational", "low", "medium", "high", "critical"] },
        "confidence": { "enum": ["low", "medium", "high"] },
        "category": {
          "enum": [
            "native_waf", "reconnaissance", "protocol_attack", "path_traversal", "file_disclosure",
            "rfi", "ssrf", "command_injection", "code_injection", "sqli", "xss", "ssti",
            "deserialization", "webshell", "vulnerability_exploit", "authentication_attack", "dos",
            "data_leakage", "file_upload"
          ]
        },
        "cves": { "type": "array", "items": { "type": "string", "pattern": "^CVE-[0-9]{4}-[0-9]{4,}$" }, "uniqueItems": true },
        "attack": {
          "type": "object",
          "additionalProperties": false,
          "required": ["techniques"],
          "properties": {
            "techniques": { "type": "array", "items": { "type": "string", "pattern": "^T[0-9]{4}(\\.[0-9]{3})?$" }, "uniqueItems": true }
          }
        },
        "required_fields": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true },
        "requirements": {
          "type": "object",
          "additionalProperties": false,
          "required": ["all_fields", "any_fields", "capabilities"],
          "properties": {
            "all_fields": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
            "any_fields": {
              "type": "array",
              "items": { "type": "array", "minItems": 2, "items": { "type": "string" }, "uniqueItems": true }
            },
            "capabilities": {
              "type": "array",
              "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
              "uniqueItems": true
            }
          }
        },
        "match": { "$ref": "#/$defs/condition" },
        "aggregate": { "$ref": "#/$defs/aggregate" },
        "provenance": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/provenance" } },
        "false_positives": { "type": "array", "items": { "type": "string" } },
        "tuning": { "type": "string" }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "event" } } },
          "then": { "required": ["match"], "not": { "required": ["aggregate"] } }
        },
        {
          "if": { "properties": { "kind": { "const": "aggregate" } } },
          "then": { "required": ["aggregate"], "not": { "required": ["match"] } }
        }
      ]
    }
  }
}

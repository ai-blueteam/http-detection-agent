          "uploadedfilenames": [
            "photos/image.png"
          ]
        },
        {
          "uploadedfilenames": [
            "report..txt"
          ]
        },
        {
          "uploadedfilenames": [
            "C:\\fakepath\\picture.jpg"
          ]
        }
      ]
    },
    {

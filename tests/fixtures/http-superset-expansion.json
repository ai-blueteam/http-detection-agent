{
  "description": "Synthetic detection fixtures, never executed. Parsed metadata fixtures represent adapter output; they do not test or implement multipart/JSON/GraphQL/JWT parsers. Assertions concern the named rule; overlapping families may also match.",
  "rules": [
    {
      "rule_id": "http.upload.server-script",
      "positive": [
        {
          "uploadedfilenames": [
            "avatar.jpg",
            "shell.PHp"
          ]
        },
        {
          "uploadedfilenames": [
            "image.jpg.jsp"
          ]
        },
        {
          "uploadedfilenames": [
            "s.php\u0000.jpg"
          ]
        },
        {
          "uploadedfilenames": [
            "x.aspx. "
          ]
        }
      ],
      "negative": [
        {
          "uploadedfilenames": [
            "photo.png",
            "manual.php.txt"
          ]
        },
        {
          "uploadedfilenames": [
            "report.docx"
          ]
        },
        {
          "requestbody": "{\"filename\":\"shell.php\"}"
        }
      ]
    },
    {
      "rule_id": "http.upload.path-traversal",
      "positive": [
        {
          "uploadedfilenames": [

        {
          "responsebody": "A guide to Index of pages"
        }
      ]
    },
    {
      "rule_id": "http.response.cgi-source",
      "positive": [
        {
          "responsebody": "#!/usr/bin/python3\nprint('Content-Type: text/plain')\n"
        },
        {
          "responsebody": "#!/usr/bin/env perl\nprint 'hello';"

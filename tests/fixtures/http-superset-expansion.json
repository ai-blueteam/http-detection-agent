        {
          "uploadedfilenames": [
            "sess_aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
          ]
        },
        {
          "uploadedfilenames": [
            "sess_aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.txt"
          ]
        }
      ]
    },
    {
      "rule_id": "http.upload.php-execution-content",
      "positive": [
        {
          "uploadedfilecontents": [
            "<?php system('id'); ?>"
          ]
        },
        {
          "uploadedfilecontents": [
            "<?PHP\n eval($input);"
          ]
        }
      ],
      "negative": [
        {
          "uploadedfilecontents": [
            "<?php echo 'hello'; ?>"
          ]
        },
        {
          "uploadedfilecontents": [
            "<?php",
            "system('id');"
          ]
        },
        {
          "uploadedfilecontents": [
            "an example of system() with no PHP tag"
          ]
        },
        {
          "requestbody": "<?php system('id'); ?>"
        }
      ]
    },
    {
      "rule_id": "http.multipart.deprecated-transfer-encoding",
      "positive": [
        {
          "multipartpartheaders": [
            "Content-Disposition: form-data; name=\"a\"",
            "Content-Transfer-Encoding: base64"
          ]
        },
        {
          "multipartpartheaders": [
            "CONTENT-TRANSFER-ENCODING: binary"
          ]
        }
      ],
      "negative": [
        {
          "multipartpartheaders": [
            "Content-Disposition: form-data; name=\"a\"",
            "Content-Type: text/plain"
          ]
        },
        {
          "requestbody": "The document describes Content-Transfer-Encoding: base64"
        }
      ]
    },
    {
      "rule_id": "http.multipart.unsafe-charset",
      "positive": [
        {
          "multipartcharsets": [
            "UTF-16LE"
          ]
        },
        {
          "multipartcharsets": [
            "utf-8",
            "utf-7"
          ]
        }
      ],
      "negative": [
        {
          "multipartcharsets": [
            "utf-8",
            "iso-8859-1"
          ]
        },
        {
          "multipartcharsets": [
            "windows-1252"
          ]
        },
        {
          "multipartcharsets": [
            "not-utf-7"
          ]
        }
      ]
    },
    {
      "rule_id": "http.response.directory-listing",
      "positive": [
        {
          "responsebody": "<html><title>Index of /public</title>\n<h1>Index of /public</h1></html>"
        },
        {
          "responsebody": "<A HREF=\"/\">[To Parent Directory]</A><br>"
        }
